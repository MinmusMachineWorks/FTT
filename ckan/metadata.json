{
  "spec_version": "v1.4",
  "identifier": "USI-FTT-MM",
  "name": "USI Freight Transport Technologies (MMW)",
  "abstract": "Modular parts for all of your hauling, mining, and exploration needs, with community fixes",
  "description": "Minmus Machine Works fork of https://github.com/UmbraSpaceIndustries/FTT with community fixes. It replaces the official USI-FTT package (provides and conflicts with it), so mods that depend on USI-FTT still install.",
  "author": [
    "RoverDude",
    "Machine-Maker"
  ],
  "license": "restricted",
  "release_status": "stable",
  "ksp_version_min": "1.8",
  "ksp_version_max": "1.12.99",
  "resources": {
    "homepage": "https://github.com/MinmusMachineWorks/FTT",
    "repository": "https://github.com/MinmusMachineWorks/FTT",
    "x_upstream": "https://github.com/UmbraSpaceIndustries/FTT"
  },
  "provides": [
    "USI-FTT"
  ],
  "conflicts": [
    {
      "name": "USI-FTT"
    },
    {
      "name": "SETI-CommunityTechTree"
    }
  ],
  "depends": [
    {
      "name": "FirespitterCore",
      "min_version": "v7.6.0"
    },
    {
      "name": "ModuleManager",
      "min_version": "2.8.0"
    },
    {
      "name": "USITools",
      "min_version": "0.9.0.0"
    },
    {
      "name": "CommunityResourcePack",
      "min_version": "0.7.0.0"
    }
  ],
  "install": [
    {
      "find": "UmbraSpaceIndustries/FTT",
      "install_to": "GameData/UmbraSpaceIndustries"
    }
  ]
}
